diff --git a/osfmk/console/serial_console.c b/osfmk/console/serial_console.c
index e6d38d3..d98bc5c 100644
--- a/osfmk/console/serial_console.c
+++ b/osfmk/console/serial_console.c
@@ -248,6 +248,49 @@ get_cons_ops_index(void)
  * @param poll Whether or not this call should poll instead of going to sleep
  *             waiting for an interrupt when the hardware device isn't ready
  */
+/*
+ * umi: mirror every character handed to the console (video or serial) into the
+ * persistent ramoops console ring at 0xb0000000, so the log survives a kernel
+ * that stops silently. The ring uses the Linux persistent_ram_buffer layout:
+ *   u32 sig (0x43474244), u32 start, u32 size, u8 data[cap]
+ * kprintf() output reaches the hardware through _cnputc(), not through the
+ * buffered console_write_char() path, so the mirror has to live here.
+ */
+extern unsigned long umi_trace_console_address;
+
+static void
+umi_ramoops_putc(char c)
+{
+	volatile uint32_t *hdr;
+	uint32_t at, size;
+	const uint32_t cap = 0x1fff4U;
+
+	if (!umi_trace_console_address) {
+		return;
+	}
+	hdr = (volatile uint32_t *)umi_trace_console_address;
+	if (hdr[0] != 0x43474244U) {
+		return;
+	}
+	at = hdr[1];
+	size = hdr[2];
+	if (at >= cap) {
+		at = 0;
+	}
+	((volatile unsigned char *)hdr)[12 + at] = (unsigned char)c;
+	at++;
+	if (at >= cap) {
+		at = 0;
+	}
+	if (size < cap) {
+		size++;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	hdr[2] = size;
+	hdr[1] = at;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
 static inline void
 _cnputc(char c, bool poll)
 {
@@ -260,6 +303,7 @@ _cnputc(char c, bool poll)
 		_cnputc('\r', poll);
 	}
 
+	umi_ramoops_putc(c);
 	cons_ops[idx].putc(c, poll);
 }
 
@@ -790,3 +834,20 @@ console_serial_test(void)
 	return KERN_SUCCESS;
 }
 #endif
+
+/*
+ * umi: point the console backend back at the video console. The serial
+ * console has no device behind it here, so every kprintf written through it
+ * would vanish.
+ */
+uint32_t
+umi_console_ops_index(void)
+{
+	return cons_ops_index;
+}
+
+void
+umi_force_video_console(void)
+{
+	cons_ops_index = VC_CONS_OPS;
+}
diff --git a/pexpert/arm/pe_init.c b/pexpert/arm/pe_init.c
index bb7882d..ae37e61 100644
--- a/pexpert/arm/pe_init.c
+++ b/pexpert/arm/pe_init.c
@@ -432,6 +432,17 @@ PE_init_platform(boolean_t vm_initialized, void *args)
 			) % 4;
 		PE_state.video.v_scale = ((boot_args_ptr->Video.v_depth >> kBootVideoDepthScaleShift) & kBootVideoDepthMask) + 1;
 		PE_state.video.v_display = boot_args_ptr->Video.v_display;
+		/*
+		 * umi: DarwinBoot and UmiInheritedFbDxe both point Video at
+		 * 0x9c000000, which is the buffer the panel actually scans out.
+		 * Bit 0 of v_baseAddr means "physical, please map".
+		 */
+		PE_state.video.v_baseAddr = 0x9C000001UL;
+		PE_state.video.v_rowBytes = 4320;
+		PE_state.video.v_width = 1080;
+		PE_state.video.v_height = 2340;
+		PE_state.video.v_depth = 32;
+		PE_state.video.v_display = 1;
 		strlcpy(PE_state.video.v_pixelFormat, "BBBBBBBBGGGGGGGGRRRRRRRR", sizeof(PE_state.video.v_pixelFormat));
 	}
 	if (!vm_initialized) {
@@ -538,9 +549,47 @@ PE_create_console(void)
 
 #if UMI_EARLY_TRACE
 	umi_early_trace(0x62, PE_state.video.v_display, umi_trace_console_address);
+#endif
+#if UMI_EARLY_TRACE
+	/*
+	 * umi: take the panel over here instead of inside initialize_screen().
+	 * Map the GOP base ourselves and hand initialize_screen() a already-mapped
+	 * virtual address (bit0 clear), so it never has to decide anything.
+	 */
+	{
+		extern void umi_force_video_console(void);
+		extern uint32_t umi_console_ops_index(void);
+		vm_offset_t umi_fb = ml_io_map(0x9C000000UL, 2340UL * 4320UL);
+
+		umi_early_trace(0x64, (unsigned long)umi_fb, umi_trace_console_address);
+		if (umi_fb) {
+			PE_state.video.v_baseAddr = umi_fb;      /* mapped VA, bit0 clear */
+			PE_state.video.v_rowBytes = 4320;
+			PE_state.video.v_width = 1080;
+			PE_state.video.v_height = 2340;
+			PE_state.video.v_depth = 32;
+			PE_state.video.v_display = 1;
+		}
+		umi_force_video_console();
+		umi_early_trace(0x65, (unsigned long)umi_console_ops_index(),
+		    umi_trace_console_address);
+	}
 #endif
 	if (PE_state.video.v_display) {
 		PE_initialize_console(&PE_state.video, kPEGraphicsMode);
+
+#if UMI_EARLY_TRACE
+		/*
+		 * umi: kPEGraphicsMode alone never enables the text console, so ask for
+		 * text first (sets gc_desire_text) and then acquire the screen: with
+		 * gc_desire_text set, graphics_now is FALSE and the kPEAcquireScreen arm
+		 * ends in gc_enable(TRUE).
+		 */
+		PE_initialize_console(&PE_state.video, kPETextScreen);
+		PE_initialize_console(&PE_state.video, kPEAcquireScreen);
+		umi_early_trace(0x68, (unsigned long)umi_console_ops_index(),
+		    umi_trace_console_address);
+#endif
 	} else {
 		PE_initialize_console(&PE_state.video, kPETextMode);
 	}
