diff --git a/osfmk/console/serial_console.c b/osfmk/console/serial_console.c
index e6d38d3..f887e03 100644
--- a/osfmk/console/serial_console.c
+++ b/osfmk/console/serial_console.c
@@ -248,6 +248,136 @@ get_cons_ops_index(void)
  * @param poll Whether or not this call should poll instead of going to sleep
  *             waiting for an interrupt when the hardware device isn't ready
  */
+/*
+ * umi: mirror every character handed to the console (video or serial) into the
+ * persistent ramoops console ring at 0xb0000000, so the log survives a kernel
+ * that stops silently. The ring uses the Linux persistent_ram_buffer layout:
+ *   u32 sig (0x43474244), u32 start, u32 size, u8 data[cap]
+ * kprintf() output reaches the hardware through _cnputc(), not through the
+ * buffered console_write_char() path, so the mirror has to live here.
+ */
+extern unsigned long umi_trace_console_address;
+
+static void
+umi_ramoops_putc(char c)
+{
+	volatile uint32_t *hdr;
+	uint32_t at, size;
+	const uint32_t cap = 0x1fff4U;
+
+	if (!umi_trace_console_address) {
+		return;
+	}
+	hdr = (volatile uint32_t *)umi_trace_console_address;
+	if (hdr[0] != 0x43474244U) {
+		return;
+	}
+	at = hdr[1];
+	size = hdr[2];
+	if (at >= cap) {
+		at = 0;
+	}
+	((volatile unsigned char *)hdr)[12 + at] = (unsigned char)c;
+	at++;
+	if (at >= cap) {
+		at = 0;
+	}
+	if (size < cap) {
+		size++;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	hdr[2] = size;
+	hdr[1] = at;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+/*
+ * umi: miniature text console on the real panel.
+ *
+ * The XNU video console cannot be used this early: gc_enable() only allocates
+ * its character buffers once vcattach() has run, which needs the display kext.
+ * So drive the pixels ourselves - 8x16 glyphs from the kernel's own iso_font,
+ * drawn into a small window mapped from the GOP base.
+ */
+#define UMI_FB_ROWBYTES 4320U
+#define UMI_FB_COLS     135U
+#define UMI_FB_ROWS     30U
+#define UMI_FB_WORDS    (UMI_FB_ROWS * 16U * (UMI_FB_ROWBYTES / 4U))
+
+volatile uint32_t *umi_fb_base;
+
+#define iso_font umi_iso_font
+#include "iso_font.c"
+#undef iso_font
+
+static unsigned int umi_fb_col;
+static unsigned int umi_fb_row;
+
+static void
+umi_fb_scroll(void)
+{
+	volatile uint32_t *fb = umi_fb_base;
+	unsigned int shift = 16U * (UMI_FB_ROWBYTES / 4U);
+	unsigned int i;
+
+	for (i = 0; i < UMI_FB_WORDS - shift; i++) {
+		fb[i] = fb[i + shift];
+	}
+	for (; i < UMI_FB_WORDS; i++) {
+		fb[i] = 0;
+	}
+}
+
+static void
+umi_fb_putc(char c)
+{
+	volatile uint32_t *fb = umi_fb_base;
+	unsigned int x, y, line, bit;
+	unsigned char bits;
+
+	if (!fb) {
+		return;
+	}
+	if (c == '\r') {
+		umi_fb_col = 0;
+		return;
+	}
+	if (c == '\n') {
+		umi_fb_col = 0;
+		if (++umi_fb_row >= UMI_FB_ROWS) {
+			umi_fb_scroll();
+			umi_fb_row = UMI_FB_ROWS - 1;
+		}
+		return;
+	}
+	if (c == '\t') {
+		umi_fb_col = (umi_fb_col + 8U) & ~7U;
+		if (umi_fb_col >= UMI_FB_COLS) {
+			umi_fb_col = UMI_FB_COLS - 1;
+		}
+		return;
+	}
+	if ((unsigned char)c < 32) {
+		return;
+	}
+	if (umi_fb_col >= UMI_FB_COLS) {
+		umi_fb_col = 0;
+		if (++umi_fb_row >= UMI_FB_ROWS) {
+			umi_fb_scroll();
+			umi_fb_row = UMI_FB_ROWS - 1;
+		}
+	}
+	x = umi_fb_col * 8U;
+	y = umi_fb_row * 16U;
+	for (line = 0; line < 16U; line++) {
+		bits = umi_iso_font[(unsigned char)c * 16U + line];
+		for (bit = 0; bit < 8U; bit++) {
+			fb[(y + line) * (UMI_FB_ROWBYTES / 4U) + x + bit] =
+			    (bits & (0x80U >> bit)) ? 0x00FFFFFFU : 0x00000000U;
+		}
+	}
+	umi_fb_col++;
+}
 static inline void
 _cnputc(char c, bool poll)
 {
@@ -260,6 +390,7 @@ _cnputc(char c, bool poll)
 		_cnputc('\r', poll);
 	}
 
+	umi_fb_putc(c);
 	cons_ops[idx].putc(c, poll);
 }
 
